# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID чатов, которым разрешено пользоваться ботом (через запятую). Узнать свой ID: напишите боту /start — он ответит ID.
TELEGRAM_ALLOWED_CHAT_IDS=
# Время ежедневной подборки и часовой пояс
DIGEST_TIME=10:00
TIMEZONE=Asia/Almaty

# --- Claude (анализ и сценарии) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Источник данных Instagram ---
# graph — официальный Instagram Graph API (Business Discovery), бесплатно
# apify — сторонний парсер Apify, платно
DEFAULT_SOURCE=graph

# Instagram Graph API: ID вашего бизнес-аккаунта Instagram и долгоживущий токен
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v24.0

# Apify (если используете)
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-scraper

# --- Настройки отбора ---
DIGEST_SIZE=5
OUTLIER_MIN_RATIO=3.0
RISING_MIN_RATIO=1.5
RISING_MAX_AGE_HOURS=72
MATURE_MIN_AGE_HOURS=48
LOOKBACK_DAYS=30
POSTS_PER_ACCOUNT=30
MIN_BASELINE_POSTS=6
MAX_ANALYSES_PER_RUN=8
DB_PATH=data/scout.db
