# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID чатов, которым разрешено пользоваться ботом (через запятую). Узнать свой ID: напишите боту /start — он ответит ID.
TELEGRAM_ALLOWED_CHAT_IDS=
# Время ежедневной подборки и часовой пояс
DIGEST_TIME=10:00
TIMEZONE=Asia/Almaty

# --- Claude (анализ и сценарии) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Источник данных Instagram ---
# graph — официальный Instagram Graph API (Business Discovery), бесплатно
# apify — сторонний парсер Apify, платно
DEFAULT_SOURCE=graph

# Instagram Graph API: ID вашего бизнес-аккаунта Instagram и долгоживущий токен
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v24.0

# Apify (если используете)
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-scraper

# --- Настройки отбора ---
DIGEST_SIZE=5
OUTLIER_MIN_RATIO=3.0
RISING_MIN_RATIO=1.5
RISING_MAX_AGE_HOURS=72
MATURE_MIN_AGE_HOURS=48
LOOKBACK_DAYS=30
POSTS_PER_ACCOUNT=30
MIN_BASELINE_POSTS=6
MAX_ANALYSES_PER_RUN=8
DB_PATH=data/scout.db

# --- Бот ежедневных задач (python -m daily_tasks) ---
# Отдельный бот: создайте его в @BotFather и впишите токен
TASKS_BOT_TOKEN=
# Кому можно пользоваться (ID через запятую). Пусто — всем, у каждого свой список.
TASKS_ALLOWED_CHAT_IDS=
TASKS_MORNING_TIME=09:00
TASKS_EVENING_TIME=21:00
TASKS_TIMEZONE=Asia/Almaty
TASKS_DB_PATH=data/tasks.db
# Адрес приложения (HTTPS). На Railway задаётся сам через Generate Domain.
TASKS_WEBAPP_URL=
# Голосовые задачи: ключ одного сервиса распознавания речи
OPENAI_API_KEY=
GROQ_API_KEY=
# Разбор голосового на задачи и даты делает Claude, если задан ANTHROPIC_API_KEY (см. выше)
TASKS_CLAUDE_MODEL=claude-opus-5-5
